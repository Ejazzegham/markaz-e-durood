# ============================================
# FIREBASE / FIRESTORE (database)
# ============================================
# From Firebase Console > Project settings > Service accounts >
# Generate new private key (downloads a JSON file — copy the 3 fields below).
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# Keep the surrounding quotes and the \n sequences exactly as they appear in
# the downloaded JSON — do not replace them with real line breaks.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# ============================================
# CLOUDFLARE R2 (file storage: images, PDFs, audio covers, etc.)
# ============================================
# Cloudflare dashboard > R2 > Manage R2 API Tokens > Create API Token
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="markaz-e-durood"
# Public base URL for the bucket — either the r2.dev URL Cloudflare gives you
# (Settings > Public Access) or your own custom domain mapped to the bucket.
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"

# ============================================
# AUTHENTICATION
# ============================================
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-jwt-secret-change-this-in-production"

# ============================================
# ADMIN CREDENTIALS (for `npm run db:seed`)
# ============================================
ADMIN_EMAIL="admin@markazdurood.com"
ADMIN_PASSWORD="admin123"

# ============================================
# EMAIL (SMTP) — required for "Forgot Password" reset emails
# ============================================
# Any SMTP provider works (Gmail, Outlook, SendGrid, Mailgun, Zoho, your host's
# mailbox, etc). For Gmail: use smtp.gmail.com, port 587, and a 16-character
# "App Password" from https://myaccount.google.com/apppasswords (not your
# normal Gmail password — Google blocks that for SMTP logins).
# Until these are filled in, reset links are logged to the server console
# instead of emailed, so you can still test the flow locally.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"

# ============================================
# APPLICATION SETTINGS
# ============================================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Markaz-e-Durood"
